# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
*.age
age-key*.txt
keys.txt
pve.yml

# Ansible Vault (real files and password files). Examples are allowed.
.vault_pass*
*vault_pass*
**/vault.yml
**/vault.yaml
*.vault
!*.example

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
# The provider lock file IS committed for environments (.terraform.lock.hcl),
# but not for reusable modules (see terraform/modules pattern at the end of this file).

# ---- Ansible ----
*.retry
ansible/.collections/
ansible/.cache/
ansible/.ansible/
# Generated from `terraform output` by scripts/tf-to-inventory.py
ansible/inventory/*/hosts.yml
!ansible/examples/hosts.yml.example

# ---- State backups / local scratch ----
*.tfstate.enc
backups/

# ---- Tooling / editors / OS ----
.venv/
__pycache__/
.ansible-lint-cache/
.tflint.d/
.idea/
.vscode/
*.swp
.DS_Store
terraform/modules/**/.terraform.lock.hcl
